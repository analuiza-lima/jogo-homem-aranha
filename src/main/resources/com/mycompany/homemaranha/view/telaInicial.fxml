<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<!-- tipo de layout do JavaFX usado pra posicionar elementos em lugares exatos da tela. -->

<AnchorPane prefHeight="500.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.homemaranha.controller.TelaInicialController"
            stylesheets="@../css/estilo.css">

    <children>

        <!-- FUNDO -->

        <ImageView fitWidth="900"
                   fitHeight="500"
                   preserveRatio="false">

            <image>
                <Image url="@../assets/homemaranhainicial.jpg"/>
            </image>

        </ImageView>

        <!-- TITULO -->

        <Text layoutX="220"
              layoutY="70"
              text="ENTRE SOMBRAS E TEIAS"
              style="-fx-font-size: 36px;
                     -fx-font-weight: bold;
                     -fx-fill: black;" />

        <!-- BOTAO IMAGENS -->

        <Button fx:id="btnImagens"
                layoutX="250"
                layoutY="380"
                prefWidth="150"
                prefHeight="55"
                text="IMAGENS"/>

        <!-- BOTAO JOGAR -->

        <Button fx:id="btnJogar"
                layoutX="500"
                layoutY="380"
                prefWidth="150"
                prefHeight="55"
                text="JOGAR"/>

    </children>

</AnchorPane>